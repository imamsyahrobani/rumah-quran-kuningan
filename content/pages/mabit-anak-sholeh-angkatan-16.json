ottom: 52px; padding-right: 40px; }\n  .mb-hero h1 { color: #fff; font-size: clamp(2.5rem, 6vw, 4rem); line-height: 1.05; margin-bottom: 8px; font-weight: 600; }\n  .mb-hero h1 span { color: var(--sun); display: block; }\n  .mb-sub { color: #d9dbee; font-size: 1.12rem; margin: 14px 0 24px; }\n  .mb-chips { display: flex; flex-wrap: wrap; margin: 0 0 28px -8px; }\n  .mb-chip { margin: 0 0 8px 8px; padding: 10px 16px; border-radius: 999px; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2); color: #fff; font-size: .95rem; font-weight: 600; }\n  .mb-chip.sun { background: var(--sun); color: #1a1400; border-color: var(--sun); }\n  .mb-poster { flex: 0 0 36%; }\n  .mb-poster .frame { border: 10px solid var(--gold); border-bottom: none; border-radius: 8px 8px 0 0; overflow: hidden; box-shadow: 0 30px 60px -25px rgba(0,0,0,.55); background: var(--ink-2); }\n  .mb-poster img { width: 100%; height: auto; display: block; }\n\n  /* ---- batas pendaftaran ---- */\n  .mb-deadline { background: var(--sun); color: #1a1400; padding: 22px 0; }\n  .mb-deadline-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; }\n  .mb-deadline strong { font-family: 'Fraunces', serif; font-size: 1.2rem; font-weight: 600; }\n  .mb-count { display: flex; margin: 8px 0; }\n  .mb-count div { text-align: center; background: var(--ink); color: #fff; border-radius: 8px; padding: 8px 12px; margin-left: 8px; min-width: 62px; }\n  .mb-count b { display: block; font-size: 1.4rem; line-height: 1.1; }\n  .mb-count small { font-size: .7rem; text-transform: uppercase; letter-spacing: .06em; color: #cfd0e6; }\n  .mb-closed-only { display: none; }\n  .mb.is-closed .mb-closed-only { display: inline; }\n  .mb.is-closed .mb-open-only { display: none; }\n  .mb.is-closed .mb-count { display: none; }\n\n  /* ---- section umum ---- */\n  .mb-sec { padding: 64px 0; }\n  .mb-sec.alt { background: var(--parchment-2); }\n  .mb-title { font-size: clamp(1.6rem, 3.4vw, 2.2rem); color: var(--ink); margin-bottom: 8px; }\n  .mb-lead { color: var(--text-soft); max-width: 62ch; }\n  .mb-intro { max-width: 720px; margin: 0 auto; font-size: 1.1rem; }\n  .mb-intro .salam { font-family: 'Fraunces', serif; font-style: italic; color: var(--maroon); font-size: 1.2rem; }\n\n  /* ---- rangkaian kegiatan ---- */\n  .mb-acts { display: flex; flex-wrap: wrap; margin: 28px -8px 0; }\n  .mb-act { flex: 1 1 170px; margin: 8px; background: #fff; border: 1px solid rgba(30,35,64,.12); border-radius: 12px; padding: 24px 16px; text-align: center; }\n  .mb-act .ic { width: 62px; height: 62px; border-radius: 50%; background: #FBF3D6; border: 2px solid var(--sun); margin: 0 auto 14px; font-size: 1.6rem; line-height: 58px; text-align: center; }\n  .mb-act h3 { font-size: 1.05rem; color: var(--ink); }\n\n  /* ---- benefit ---- */\n  .mb-ben { display: flex; flex-wrap: wrap; margin: 28px -8px 0; }\n  .mb-ben div { flex: 1 1 220px; margin: 8px; padding: 18px 20px 18px 54px; background: #fff; border-radius: 10px; position: relative; font-weight: 600; color: var(--ink); }\n  .mb-ben div::before { content: \"\\2713\"; position: absolute; left: 18px; top: 50%; margin-top: -15px; width: 30px; height: 30px; line-height: 30px; text-align: center; border-radius: 50%; background: var(--sun); color: #1a1400; font-weight: 700; }\n\n  /* ---- info penting ---- */\n  .mb-info { display: flex; flex-wrap: wrap; margin: 28px -8px 0; }\n  .mb-info div { flex: 1 1 220px; margin: 8px; padding: 22px; border-left: 4px solid var(--gold); background: #fff; border-radius: 0 10px 10px 0; }\n  .mb-info small { display: block; font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; color: var(--gold-deep); font-weight: 700; margin-bottom: 6px; }\n  .mb-info span { color: var(--ink); font-weight: 600; }\n  .mb-info a { color: var(--maroon); }\n  .mb-info div.loc { flex: 1.8 1 280px; }\n\n  /* ---- ajakan daftar ---- */\n  .mb-cta { background: var(--ink); color: #fff; text-alig