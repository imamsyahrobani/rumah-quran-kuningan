</div>\n\n<script>\n  (function () {\n    // GANTI: batas akhir pendaftaran (format tahun-bulan-tanggal, jam 23:59 WIB)\n    var end = new Date('2026-10-29T23:59:59+07:00').getTime();\n    var root = document.getElementById('mb');\n    function pad(n) { return ('0' + n).slice(-2); }\n    function tick() {\n      var diff = end - Date.now();\n      if (diff <= 0) {\n        root.className += ' is-closed';\n        return false;\n      }\n      document.getElementById('mb-d').textContent = pad(Math.floor(diff / 86400000));\n      document.getElementById('mb-h').textContent = pad(Math.floor((diff % 86400000) / 3600000));\n      document.getElementById('mb-m').textContent = pad(Math.floor((diff % 3600000) / 60000));\n      document.getElementById('mb-s').textContent = pad(Math.floor((diff % 60000) / 1000));\n      return true;\n    }\n    if (tick()) {\n      var timer = setInterval(function () { if (!tick()) clearInterval(timer); }, 1000);\n    }\n  })();\n</script>\n",
